{
  "name": "Weekly - Trimtab: upstream retro",
  "cron_expression": "0 9 * * 6",
  "enabled": false,
  "mcp_connections": [],
  "job_config": {
    "ccr": {
      "environment_id": "$environment_id",
      "events": [ { "data": { "message": { "role": "user", "content": $prompt_json } } } ],
      "session_context": {
        "allowed_tools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep"],
        "model": "claude-opus-5",
        "sources": [ { "git_repository": { "url": "https://github.com/$instance_repo" } } ]
      }
    }
  }
}
