#!/usr/bin/env bash
# Trimtab's command line: `trimtab <command> --help` for each command.
#
# Resolves through the ~/.claude/bin symlink to the checkout that holds the
# `trimtab` package, so it runs the same code from anywhere. Standard library
# plus PyYAML only (plan section 4).
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# -P: never put the working directory on sys.path, so a trimtab/ directory
# there cannot shadow this checkout's package (it would run instead, silently).
PYTHONPATH="$here/..${PYTHONPATH:+:$PYTHONPATH}" exec python3 -P -m trimtab "$@"
