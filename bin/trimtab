#!/usr/bin/env bash
# Trimtab's command line: `trimtab <command> --help` for each command.
#
# Resolves through the ~/.claude/bin symlink to the checkout that holds the
# `trimtab` package, so it runs the same code from anywhere. Standard library
# plus PyYAML only.
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# -I: isolated, as the hooks run it (ADR 0035). No working directory or script
# directory on sys.path, no user site-packages (a .pth there runs at start up),
# no PYTHON* variables. run_module.py loads trimtab from this checkout without
# putting the checkout root on sys.path, so no file at the root (a json.py, a
# sitecustomize.py) can stand in for a standard-library module. PyYAML comes
# from the system site-packages, so -S is not used.
# -B: write no bytecode beside the package; a snapshot is never written.
exec python3 -I -B "$here/../hooks/run_module.py" "$here/.." trimtab.__main__ "$@"
